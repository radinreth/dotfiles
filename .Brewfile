# Dev machine packages (the Apple Silicon Mac, set up 2026-10): `brew bundle --global` installs
# them, `brew bundle cleanup --global` removes anything not listed. Languages come from mise,
# databases from Docker. Docker Desktop, IntelliJ IDEA and Telegram are installed outside Homebrew.

# shell and tooling
brew "git"
brew "git-lfs"
brew "git-open"
brew "gh"
brew "tmux"
brew "stow"
brew "mise"
brew "uv"
brew "direnv"
brew "fzf"
brew "ripgrep"
brew "fd"
brew "jq"
brew "wget"
brew "tree"
brew "vim"
brew "yazi"
brew "coreutils"
brew "gnu-sed"
brew "watchman"
brew "mkcert"
brew "overmind"
brew "helm"

# shell comforts that replace oh-my-zsh (~/.zsh/aliases.zsh, ~/.zsh/plugins.zsh)
brew "eza"
brew "starship"
brew "zoxide"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# build deps for Ruby and native gems (pg, image_processing)
brew "openssl@3"
brew "libyaml"
brew "readline"
brew "gmp"
brew "libpq"
brew "imagemagick"
brew "vips"
brew "poppler"

# apps
cask "ghostty"
cask "google-chrome"
cask "claude-code"
cask "rectangle"
cask "linearmouse"
cask "keepingyouawake"
cask "discord"

# fonts
cask "font-jetbrains-mono"
cask "font-jetbrains-mono-nerd-font"
cask "font-hack-nerd-font"
cask "font-iosevka"

# VS Code and its extensions (`code --list-extensions` on the old Mac, 2026-10-30).
# VS Code was installed by hand on the new Mac: `brew install --cask --adopt visual-studio-code` once.
cask "visual-studio-code"
vscode "ambar.bundle-size"
vscode "anthropic.claude-code"
vscode "christian-kohler.path-intellisense"
vscode "dbaeumer.vscode-eslint"
vscode "dracula-theme.theme-dracula"
vscode "dsznajder.es7-react-js-snippets"
vscode "editorconfig.editorconfig"
vscode "equimper.react-native-react-redux"
vscode "eriklynd.json-tools"
vscode "esbenp.prettier-vscode"
vscode "fcrespo82.markdown-table-formatter"
vscode "formulahendry.auto-close-tag"
vscode "formulahendry.auto-rename-tag"
vscode "formulahendry.code-runner"
vscode "github.vscode-github-actions"
vscode "mechatroner.rainbow-csv"
vscode "mgmcdermott.vscode-language-babel"
vscode "ms-vscode-remote.remote-ssh"
vscode "ms-vscode-remote.remote-ssh-edit"
vscode "ms-vscode.js-debug"
vscode "ms-vscode.remote-explorer"
vscode "ms-vscode.vscode-typescript-next"
vscode "naumovs.color-highlight"
vscode "naumovs.theme-oceanicnext"
vscode "oderwat.indent-rainbow"
vscode "pflannery.vscode-versionlens"
vscode "pkief.material-icon-theme"
vscode "redhat.vscode-yaml"
vscode "ritwickdey.liveserver"
vscode "shd101wyy.markdown-preview-enhanced"
vscode "tal7aouy.rainbow-bracket"
vscode "vquelque.markfiles"
vscode "vscjava.migrate-java-to-azure"
vscode "vscjava.vscode-java-upgrade"
vscode "vscode-icons-team.vscode-icons"
vscode "vue.volar"
vscode "wayou.vscode-todo-highlight"
vscode "yzhang.markdown-all-in-one"
