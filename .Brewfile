# Dev machine packages: `brew bundle --global` installs them, `brew bundle cleanup --global`
# removes anything not listed. Languages come from mise, databases from Docker.

# shell and tooling
brew "git"
brew "git-lfs"
brew "gh"
brew "tmux"
brew "stow"
brew "mise"
brew "uv"
brew "direnv"
brew "fzf"
brew "ripgrep"
brew "fd"
brew "jq"
brew "wget"
brew "tree"
brew "vim"
brew "yazi"
brew "coreutils"
brew "gnu-sed"
brew "watchman"
brew "mkcert"
brew "overmind"
brew "helm"

# build deps for Ruby and native gems (pg, image_processing)
brew "openssl@3"
brew "libyaml"
brew "readline"
brew "gmp"
brew "libpq"
brew "imagemagick"
brew "vips"
brew "poppler"

# apps
cask "orbstack"
cask "iterm2"
cask "rectangle"
cask "linearmouse"
cask "font-hack-nerd-font"
